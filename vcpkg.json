{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "scrapengine",
  "version-string": "0.8.0",
  "description": "A cross-platform 2D/3D game engine",
  "homepage": "https://github.com/Anwar/ScrapEngine",
